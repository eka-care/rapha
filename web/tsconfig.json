{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "//": "validate.check.ts runs under node, not vite: it imports node: builtins and diffs against python. Type checking it would mean pulling in @types/node for one file.",
  "exclude": ["src/validate.check.ts", "src/voice/voice.check.ts", "src/messages.check.ts",
              "src/scribe/scribe.check.ts", "src/abha/abha.check.ts", "src/loops.check.ts",
              "src/grants.check.ts", "src/style.check.ts", "src/ui.check.ts", "src/agent.check.ts",
              "src/live.check.ts", "src/pwa.check.ts", "src/desk.check.ts",
              "src/thread/earlier.check.ts", "src/thread/fold.check.ts", "src/thread/commands.check.ts", "src/thread/arc-scale.check.ts",
              "src/app/guide.check.ts", "src/app/width.check.ts", "src/form/span.check.ts", "src/ui/pick.check.ts", "src/scribe/dictate.check.ts",
              "src/auth/client.check.ts", "src/view/grid.check.ts",
              "src/assistant/assistant.check.ts"]
}
