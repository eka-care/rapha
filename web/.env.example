# Copy to .env.local. None of these is a secret except the last, and the last
# should stay empty on anything that is not a developer's own machine.

# The Eka MedAssist agent behind the "ask anything" medical assistant.
# Leave empty and the assistant says it is not set up.
VITE_AGENT_ID=
# "development" | "staging" | "production"
VITE_ENVIRONMENT=development
# Optional, for testing the signed-in path only. It is baked into the build,
# so everyone who loads that build would share it. Empty means guest.
VITE_AUTH_TOKEN=
