    },
    {
      "link_id": "assessment",
      "text": "Assessment",
      "type": "text",
      "required": true
    },
    {
      "link_id": "diagnosis",
      "text": "Diagnosis",
      "type": "group",
      "repeats": true,
      "required": false,
      "styling_metadata": {
        "phc": {
          "short": "Diagnosis",
          "row": "diagnosis",
          "help": "One row per condition. A condition is four answers and not a phrase: what was found, whether the patient has it now, how sure you are, and since when. The list of conditions this build can code is short, and a condition that is not on it belongs in the assessment as narrative."
        }
      },
      "questions": [
        {
          "link_id": "condition",
          "text": "Condition",
          "type": "choice",
          "answer_value_set": "condition-code",
          "required": true,
          "styling_metadata": {
            "phc": {
              "short": "Condition",
              "help": "The finding, as a SNOMED CT clinical finding. The list is short because no published list of the conditions a health centre records was available to seed it."
            }
          }
        },
        {
          "link_id": "clinical_status",
          "text": "Clinical status",
          "type": "choice",
          "answer_value_set": "condition-clinical-status",
          "required": true,
          "styling_metadata": {
            "phc": {
              "short": "Status",
              "help": "Whether the patient has this now. A past illness is resolved, with an onset."
            }
          }
        },
        {
          "link_id": "verification_status",
          "text": "How sure",
          "type": "choice",
          "answer_value_set": "condition-verification-status",
          "required": true,
          "styling_metadata": {
            "phc": {
              "short": "How sure",
              "help": "Confirmed only when you are. A finding the patient denies is refuted, which records it without asserting it. A guess is unconfirmed. This answer is why a denied symptom cannot become a diagnosis."
            }
          }
        },
        {
          "link_id": "onset",
          "text": "Since",
          "type": "date",
          "required": false,
          "styling_metadata": {
            "phc": {
              "short": "Since",
              "help": "When it started, if it is known. Left blank rather than guessed."
            }
          }
        }
      ]
    },
    {
      "link_id": "plan",
      "text": "Plan",
      "type": "text",
      "required": false
    }
  ]
