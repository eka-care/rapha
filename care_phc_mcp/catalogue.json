  "instruments": {
    "phc.inst.consult-scribe": {
      "commit": "tap",
      "fallback": "form",
      "fields": [],
      "grammar": null,
      "id": "phc.inst.consult-scribe",
      "kind": "scribe",
      "operations": [
        "phc.op.consult-document",
        "phc.op.rx-prescribe"
      ],
      "readback": "required",
      "summary": "With the patient's capture consent, the consultation is transcribed and a draft note, diagnosis list and prescription are offered for the doctor to edit and confirm.",
      "title": "Ambient scribe for the consultation",
      "type": "instrument",
      "types": []
    },
    "phc.inst.vitals-device": {
      "commit": "tap",
      "fallback": "keypad",
      "fields": [
        "systolic",
        "diastolic",
        "pulse",
        "spo2"
      ],
      "grammar": null,
      "id": "phc.inst.vitals-device",
      "kind": "device",
      "operations": [
        "phc.op.vitals-record"
      ],
      "readback": "required",
      "summary": "A paired BP cuff or pulse oximeter fills the field. The nurse still commits.",
      "title": "Read from a connected monitor",
      "type": "instrument",
      "types": []
    },
    "phc.inst.vitals-voice": {
      "commit": "tap",
      "fallback": "keypad",
      "fields": [
        "systolic",
        "diastolic",
        "pulse",
        "spo2",
        "weight",
        "temperature"
      ],
      "grammar": "number",
      "id": "phc.inst.vitals-voice",
      "kind": "constrained-voice",
      "operations": [
        "phc.op.vitals-record"
      ],
      "readback": "required",
      "summary": "Say one number for one field. It is parsed against a number grammar, shown back on screen, and committed only by a tap. It falls back to the keypad.",
