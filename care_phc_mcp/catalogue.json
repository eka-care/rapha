    "phc.op.lab-result-enter": {
      "capability": "lab.result.enter",
      "description": "The lab technician types in what the test measured. This is a number, and a\nnumber entered wrongly here is acted on at district review months later\nwithout anybody noticing it was ever wrong.",
      "emits": [
        "lab.resulted",
        "lab.critical"
      ],
      "fields": [
        {
          "link_id": "analyte",
          "options": null,
          "required": true,
          "text": "Analyte",
          "type": "string"
        },
        {
          "link_id": "value",
          "options": null,
          "required": true,
