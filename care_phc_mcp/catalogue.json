  "operations": {
    "lab.op.referral-accession": {
      "capability": "order.accession",
      "description": "Somebody outside this laboratory asked for a test. The accession desk records\nwho the patient is, who asked, and which panel. Nothing clinical is asserted\nyet.",
      "emits": [
        "order.accessioned"
      ],
      "fields": [
        {
          "link_id": "name",
          "options": null,
          "required": true,
          "text": "Full name",
          "type": "string"
        },
        {
          "link_id": "age",
          "options": null,
          "required": true,
          "text": "Age",
          "type": "integer"
        },
        {
          "link_id": "sex",
          "options": [
            "female",
            "male",
            "other"
          ],
          "required": true,
          "text": "Sex",
          "type": "choice"
        },
        {
          "link_id": "phone",
          "options": null,
          "required": true,
          "text": "Mobile",
          "type": "string"
        },
        {
          "link_id": "referrer_name",
          "options": null,
          "required": true,
          "text": "Referring clinician",
          "type": "string"
        },
        {
          "link_id": "referrer_contact",
          "options": null,
          "required": false,
          "text": "Referrer contact (phone or portal id)",
          "type": "string"
        },
        {
          "link_id": "panel",
          "options": [
            "cbc",
            "bmp"
          ],
          "required": true,
          "text": "Panel requested",
          "type": "choice"
        }
      ],
      "id": "lab.op.referral-accession",
      "input": "lab.schema.accession-v1",
      "instrument": "form",
      "irreversibility": "reversible",
      "kind": "write",
      "preconditions": [
        "not order.accessioned"
      ],
      "scope_qualifier": null,
      "short": "Accession",
      "station": "accession",
      "summary": "Register the referred patient and the panel ordered for them.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Accession a referral",
      "tool": "propose_referral_accession",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "patient",
        "service_request",
        "questionnaire_response"
      ]
    },
    "lab.op.report-release": {
      "capability": "report.release",
      "description": "The report goes to the referrer. A released result is acted on by somebody\nthis laboratory cannot reach, so the release is irreversible: an agent\ncannot propose it and a person has to tap an un-prefilled confirm.",
      "emits": [
        "report.released"
      ],
      "fields": [
        {
          "link_id": "channel",
          "options": [
            "portal",
            "print",
            "phone"
          ],
          "required": true,
          "text": "Send by",
          "type": "choice"
        },
        {
          "link_id": "attest",
          "options": null,
          "required": true,
          "text": "I attest the verified result is the one being released",
          "type": "boolean"
        },
        {
          "link_id": "note",
          "options": null,
          "required": false,
          "text": "Note to the referrer",
          "type": "text"
        }
      ],
      "id": "lab.op.report-release",
      "input": "lab.schema.release-v1",
      "instrument": "form",
      "irreversibility": "irreversible",
      "kind": "write",
      "preconditions": [
        "result.verified",
        "not report.released"
      ],
      "scope_qualifier": null,
      "short": "Release",
      "station": "release",
      "summary": "Send the verified report to the referring clinician.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Release the report",
      "tool": "propose_report_release",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "questionnaire_response"
      ]
    },
    "lab.op.result-enter": {
      "capability": "result.enter",
      "description": "A number per analyte. Each analyte carries three bands on its own question:\na plausible band that blocks the write, a critical band that raises\n`lab.critical`, and a reference interval that is written down but that\nnothing in the kernel reads.",
      "emits": [
        "result.entered",
        "lab.critical"
      ],
      "fields": [
        {
          "link_id": "panel",
          "options": [
            "cbc",
            "bmp"
          ],
          "required": true,
          "text": "Panel",
          "type": "choice"
        },
        {
          "link_id": "haemoglobin",
          "options": null,
          "required": false,
          "text": "Haemoglobin",
          "type": "decimal"
        },
        {
          "link_id": "wbc",
          "options": null,
          "required": false,
          "text": "White cell count",
          "type": "decimal"
        },
        {
          "link_id": "platelets",
          "options": null,
          "required": false,
          "text": "Platelets",
          "type": "decimal"
        },
        {
          "link_id": "glucose",
          "options": null,
          "required": false,
          "text": "Glucose",
          "type": "decimal"
        },
        {
          "link_id": "creatinine",
          "options": null,
          "required": false,
          "text": "Creatinine",
          "type": "decimal"
        },
        {
          "link_id": "sodium",
          "options": null,
          "required": false,
          "text": "Sodium",
          "type": "decimal"
        },
        {
          "link_id": "potassium",
          "options": null,
          "required": false,
          "text": "Potassium",
          "type": "decimal"
        },
        {
          "link_id": "override_reason",
          "options": null,
          "required": false,
          "text": "Reason for accepting an out of range value",
          "type": "text"
        }
      ],
      "id": "lab.op.result-enter",
      "input": "lab.schema.panel-result-v1",
      "instrument": "form",
      "irreversibility": "correctable",
      "kind": "write",
      "preconditions": [
        "specimen.collected",
        "not result.entered"
      ],
      "scope_qualifier": null,
      "short": "Result",
      "station": "processing",
      "summary": "One value per analyte, keyed or read from the analyser.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Enter panel results",
      "tool": "propose_result_enter",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "observation",
        "diagnostic_report"
      ]
    },
    "lab.op.result-verify": {
      "capability": "result.verify",
      "description": "A second person says the result is right. This is the separation of duties a\nlaboratory runs on, and it is the reason this operation exists as its own\nstep rather than as a checkbox on the result form.",
      "emits": [
        "result.verified",
        "result.rejected"
      ],
      "fields": [
        {
          "link_id": "decision",
          "options": [
            "verified",
            "rejected"
          ],
          "required": true,
          "text": "Pathologist decision",
          "type": "choice"
        },
        {
          "link_id": "comment",
          "options": null,
          "required": false,
          "text": "Interpretation or reason",
          "type": "text"
        }
      ],
      "id": "lab.op.result-verify",
      "input": "lab.schema.verify-v1",
      "instrument": "form",
      "irreversibility": "correctable",
      "kind": "write",
      "preconditions": [
        "result.entered",
        "not result.verified",
        "not actor of lab.op.result-enter"
      ],
      "scope_qualifier": null,
      "short": "Verify",
      "station": "verification",
      "summary": "A second person verifies or rejects the entered values.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Verify a preliminary result",
      "tool": "propose_result_verify",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "diagnostic_report",
        "notes"
      ]
    },
    "lab.op.specimen-collect": {
      "capability": "specimen.collect",
      "description": "The sample is drawn and labelled. From here the specimen, not the person, is\nwhat moves through the laboratory.",
      "emits": [
        "specimen.collected"
      ],
      "fields": [
        {
          "link_id": "specimen_type",
          "options": [
            "venous-blood",
            "urine",
            "swab"
          ],
          "required": true,
          "text": "Specimen",
          "type": "choice"
        },
        {
          "link_id": "container",
          "options": null,
          "required": false,
          "text": "Container or tube",
          "type": "string"
        },
        {
          "link_id": "fasting",
          "options": null,
          "required": false,
          "text": "Patient fasting",
          "type": "boolean"
        }
      ],
      "id": "lab.op.specimen-collect",
      "input": "lab.schema.specimen-v1",
      "instrument": "form",
      "irreversibility": "correctable",
      "kind": "write",
      "preconditions": [
        "order.accessioned",
        "not specimen.collected"
      ],
      "scope_qualifier": null,
      "short": "Collect",
      "station": "phlebotomy",
      "summary": "Record the draw, the sample type and its container.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Collect and label a specimen",
      "tool": "propose_specimen_collect",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "specimen"
      ]
    },
    "phc.op.abha-link": {
      "capability": "abha.link",
      "description": "An ABHA is the patient's national health number. Linking one to their record\nhere is how a hospital in another district finds their history later.",
      "emits": [
        "abha.linked"
      ],
      "fields": [
        {
          "link_id": "method",
          "options": [
            "link_existing",
            "create_new"
          ],
          "required": true,
          "text": "Journey",
          "type": "choice"
        },
        {
          "link_id": "abha_number",
          "options": null,
          "required": false,
          "text": "ABHA number",
          "type": "string"
        },
        {
          "link_id": "consent_given",
          "options": null,
          "required": true,
          "text": "Patient consents to ABHA creation or linking",
          "type": "boolean"
        }
      ],
      "id": "phc.op.abha-link",
      "input": "phc.schema.abha-link-v1",
      "instrument": "form",
      "irreversibility": "irreversible",
      "kind": "write",
      "preconditions": [
        "registered",
        "not abha.linked"
      ],
      "scope_qualifier": null,
      "short": "Link ABHA",
      "station": "reception",
      "summary": "Link this patient to their national health account.",
      "surfaces": [
        "rendered",
        "mcp"
      ],
      "title": "Create or link an ABHA",
      "tool": "propose_abha_link",
      "type": "operation",
      "verified": "unverified",
      "writes": [
        "patient"
      ]
    },
    "phc.op.capture-withdraw": {
      "capability": "encounter.document",
      "description": "The patient changes their mind. One tick and the scribe is off for the rest\nof the visit. This used to ride on the consultation form, where `assessment`\nis required, so a consent could not be withdrawn without also writing a note.\nStopping a recording is not a clinical act and must not require one.",
      "emits": [
        "capture.withdrawn"
      ],
      "fields": [
        {
          "link_id": "capture_stop",
          "options": null,
          "required": true,
          "text": "The patient asked to stop the recording. It cannot be turned back on this visit.",
          "type": "boolean"
        }
      ],
      "id": "phc.op.capture-withdraw",
      "input": "phc.schema.capture-withdraw-v1",
      "instrument": "form",
      "irreversibility": "correctable",
      "kind": "write",
