  "metrics": {
    "phc.metric.abha-coverage": {
      "certified_by": "bundle author, unverified against any reference count",
      "denominator": {
        "resource": "patient",
        "where": {
          "created_date": {
            "gte": "window.start"
          }
        }
      },
      "id": "phc.metric.abha-coverage",
      "numerator": {
        "resource": "patient",
        "where": {
          "abha_number": "*",
          "created_date": {
            "gte": "window.start"
          }
        }
      },
      "summary": "Patients seen with an ABHA linked.",
      "title": "ABHA coverage",
      "type": "metric",
      "unit": "percent",
      "window": "week"
    },
    "phc.metric.visits": {
      "certified_by": "bundle author, unverified against any reference count",
