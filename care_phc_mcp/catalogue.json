    "phc.op.household-visit": {
      "capability": "visit.household",
      "description": "An accredited social health activist or auxiliary nurse midwife visits a\nhousehold and records the visit. This is the community half of the system and\nthe half that CARE was not built for, so it is ours to design.",
      "emits": [
        "consult.documented"
      ],
      "fields": [
        {
          "link_id": "visit_type",
          "options": [
            "routine",
            "anc",
            "immunisation",
            "tb_followup",
            "ncd_followup"
          ],
          "required": true,
          "text": "Visit type",
          "type": "choice"
        },
        {
          "link_id": "consent_at_door",
          "options": null,
          "required": true,
          "text": "Household consents to this visit being recorded",
          "type": "boolean"
        },
        {
          "link_id": "narrative",
          "options": null,
          "required": false,
          "text": "What happened",
          "type": "text"
        },
