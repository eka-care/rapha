  "workflows": {
    "phc.wf.outpatient": {
      "id": "phc.wf.outpatient",
      "states": {
        "abha.linked": {
          "exists": {
            "resource": "patient",
            "where": {
              "abha_number": "*"
            }
          }
        },
        "abha.pending": {
          "all_of": [
            "registered",
            "not abha.linked"
          ]
        },
        "capture.consented": {
          "stored": true
        },
        "consult.documented": {
          "exists": {
            "resource": "notes"
          }
        },
        "dispensed.complete": {
          "gte": [
            {
              "resource": "medication_dispense"
            },
            {
              "resource": "medication_request",
              "where": {
                "status": "active"
              }
            }
          ]
        },
        "dispensed.partial": {
          "all_of": [
            {
              "exists": {
                "resource": "medication_dispense"
              }
            },
            "not dispensed.complete"
          ]
        },
        "followup.booked": {
          "exists": {
            "resource": "token_booking",
            "where": {
              "status": "booked"
            }
          }
        },
        "lab.critical": {
          "stored": true
        },
        "lab.ordered": {
          "exists": {
            "resource": "service_request"
          }
        },
        "lab.resulted": {
          "exists": {
            "resource": "diagnostic_report"
          }
        },
        "lab.validated": {
          "exists": {
            "resource": "diagnostic_report",
            "where": {
              "status": "final"
            }
          }
        },
        "registered": {
          "exists": {
            "resource": "patient"
          }
        },
        "rx.confirmed": {
          "exists": {
            "resource": "medication_request",
            "where": {
              "status": "active"
            }
          }
        },
        "vitals.flagged": {
          "stored": true
        },
        "vitals.recorded": {
          "exists": {
            "resource": "observation",
            "where": {
              "category": "vital-signs"
            }
          }
        }
      },
      "steps": [
        {
          "applies_when": null,
          "done_when": "registered",
          "operations": [
            "phc.op.patient-register",
            "phc.op.abha-link"
          ],
          "station": "reception"
        },
        {
          "applies_when": null,
          "done_when": "vitals.recorded",
          "operations": [
            "phc.op.vitals-record"
          ],
          "station": "nurse"
        },
        {
          "applies_when": null,
          "done_when": "consult.documented",
          "operations": [
            "phc.op.consult-document",
            "phc.op.rx-prescribe",
            "phc.op.lab-order"
          ],
          "station": "doctor"
        },
        {
          "applies_when": "lab.ordered",
          "done_when": "lab.resulted",
          "operations": [
            "phc.op.lab-result-enter"
          ],
          "station": "lab"
        },
        {
          "applies_when": "rx.confirmed",
          "done_when": "dispensed.complete",
          "operations": [
            "phc.op.pharmacy-dispense"
          ],
          "station": "pharmacy"
        }
      ],
      "stored": [
        "capture.consented",
        "vitals.flagged",
        "lab.critical"
      ],
      "subject": "encounter",
      "summary": "Reception, vitals, doctor, then lab and pharmacy only when the doctor sent the patient there. The current station is the first step not done.",
      "title": "Outpatient line",
      "type": "workflow"
    }
  }
